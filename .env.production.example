# Copy this file to the untracked .env.production and fill it from the
# production secret manager. Release-specific URLs and all secrets stay blank.

NODE_ENV=production
PORT=3000
API_BASE_URL=
PUBLIC_APP_REDIRECT_URI=
APP_SCHEME=trainer
CORS_ORIGINS=
TRUSTED_PROXY_CIDRS=

POSTGRES_DB=trainer_app
POSTGRES_USER=trainer_app
POSTGRES_PASSWORD=
DATABASE_URL=
# Assign independently even when it intentionally targets DATABASE_URL.
PREFLIGHT_DATABASE_URL=
PRODUCTION_DATABASE_HOSTS=
REDIS_URL=redis://redis:6379

AUTH_ENABLED=true
EMAIL_AUTH_ENABLED=true
YANDEX_AUTH_ENABLED=false
VK_AUTH_ENABLED=false
JWT_ACCESS_SECRET=
REFRESH_TOKEN_PEPPER=
EMAIL_CODE_PEPPER=
LOGIN_TICKET_PEPPER=
OAUTH_STATE_ENCRYPTION_SECRET=
ACCOUNT_DELETION_RECEIPT_TTL_HOURS=24

EMAIL_SENDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Trener
RESEND_API_KEY=

ADMIN_ENABLED=true
ADMIN_CORS_ORIGIN=
ADMIN_SESSION_PEPPER=
VITE_ADMIN_API_BASE_URL=

EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_EMAIL_AUTH_ENABLED=true
EXPO_PUBLIC_STORYBOOK_ENABLED=false
EXPO_PUBLIC_USE_MOCK_AUTH=false

EXPECTED_MIGRATION=0008_add_account_deletion_receipts
MIN_SYSTEM_EXERCISES=200
BACKUP_FORMAT=plain
BACKUP_RETENTION_DAYS=7
RELEASE_IMAGE_TAG=
