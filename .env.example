# Runtime
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
PUBLIC_APP_REDIRECT_URI=trainer://auth/callback
APP_SCHEME=trainer
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Admin
ADMIN_ENABLED=true
ADMIN_COOKIE_NAME=admin_session
ADMIN_CSRF_COOKIE_NAME=admin_csrf
ADMIN_SESSION_TTL_DAYS=7
ADMIN_CORS_ORIGIN=http://localhost:5173
ADMIN_SESSION_PEPPER=change_me
ADMIN_LOGIN_RATE_LIMIT_MAX=10
ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change_me_in_dev_only
VITE_ADMIN_API_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trainer_app

# Auth flags
AUTH_ENABLED=true
EMAIL_AUTH_ENABLED=true
YANDEX_AUTH_ENABLED=false
VK_AUTH_ENABLED=false

# Tokens
JWT_ACCESS_SECRET=change_me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_PEPPER=change_me

# Email codes
EMAIL_CODE_TTL_SECONDS=300
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_LENGTH=6
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_PEPPER=change_me

# Login tickets / OAuth state
LOGIN_TICKET_TTL_SECONDS=120
LOGIN_TICKET_PEPPER=change_me
OAUTH_STATE_TTL_SECONDS=600
OAUTH_STATE_PEPPER=change_me
OAUTH_STATE_ENCRYPTION_SECRET=change_me

# Rate limits
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_EMAIL_START_PER_EMAIL=5
RATE_LIMIT_EMAIL_START_PER_IP=20
RATE_LIMIT_EMAIL_VERIFY_PER_EMAIL=20
RATE_LIMIT_OAUTH_START_PER_IP=20

# Email sender
EMAIL_SENDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Yandex ID
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:3000/auth/oauth/yandex/callback
YANDEX_SCOPES=login:email login:info login:avatar
YANDEX_AUTHORIZATION_URL=https://oauth.yandex.ru/authorize
YANDEX_TOKEN_URL=https://oauth.yandex.ru/token
YANDEX_PROFILE_URL=https://login.yandex.ru/info

# VK ID
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=http://localhost:3000/auth/oauth/vk/callback
VK_SCOPES=vkid.personal_info email
VK_AUTHORIZATION_URL=https://id.vk.com/authorize
VK_TOKEN_URL=https://id.vk.com/oauth2/auth
VK_PROFILE_URL=https://id.vk.com/oauth2/user_info

# Mobile public env
# The first mobile release is email-only; social auth is not exposed by the client.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_AUTH_ENABLED=true
EXPO_PUBLIC_EMAIL_AUTH_ENABLED=true
EXPO_PUBLIC_USE_MOCK_AUTH=false
