generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  /// Active case-insensitive uniqueness is enforced by migration 0006.
  email                 String?                @db.Text
  emailVerifiedAt       DateTime?              @map("email_verified_at")
  displayName           String?                @map("display_name") @db.Text
  avatarUrl             String?                @map("avatar_url") @db.Text
  lastSeenAt            DateTime?              @map("last_seen_at")
  blockedAt             DateTime?              @map("blocked_at")
  blockedReason         String?                @map("blocked_reason") @db.Text
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")
  identities            AuthIdentity[]
  refreshTokens         RefreshToken[]
  loginTickets          LoginTicket[]
  clients               Client[]
  exercises             Exercise[]
  workoutTemplates      WorkoutTemplate[]
  workoutSeries         WorkoutSeries[]
  workoutSeriesCommands WorkoutSeriesCommand[]
  workoutSessions       WorkoutSession[]
  activityEvents        ActivityEvent[]

  @@map("users")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.Text
  passwordHash String    @map("password_hash") @db.Text
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions  AdminSession[]
  auditLogs AdminAuditLog[]

  @@map("admin_users")
}

model AdminSession {
  id            String    @id @default(uuid()) @db.Uuid
  adminUserId   String    @map("admin_user_id") @db.Uuid
  adminUser     AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash     String    @map("token_hash") @db.Text
  csrfTokenHash String    @map("csrf_token_hash") @db.Text
  userAgent     String?   @map("user_agent") @db.Text
  ipHash        String?   @map("ip_hash") @db.Text
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([adminUserId])
  @@index([tokenHash])
  @@map("admin_sessions")
}

model AdminAuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  adminUserId String?    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  action     String   @db.Text
  targetType String?  @map("target_type") @db.Text
  targetId   String?  @map("target_id") @db.Text
  metadata   Json?
  ipHash     String?  @map("ip_hash") @db.Text
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([adminUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

enum AdminRole {
  OWNER
  ADMIN
  SUPPORT
  READ_ONLY

  @@map("admin_role")
}

model Client {
  id        String @id @default(uuid()) @db.Uuid
  trainerId String @map("trainer_id") @db.Uuid
  trainer   User   @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  name      String       @db.Text
  phone     String?      @db.Text
  email     String?      @db.Text
  birthDate DateTime?    @map("birth_date")
  notes     String?      @db.Text
  status    ClientStatus @default(ACTIVE)
  profile   Json         @default("{}")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workoutTemplates WorkoutTemplate[]
  workoutSeries    WorkoutSeries[]
  workoutSessions  WorkoutSession[]

  @@index([trainerId])
  @@index([trainerId, deletedAt])
  @@index([trainerId, updatedAt])
  @@map("clients")
}

enum ClientStatus {
  ACTIVE
  ARCHIVED

  @@map("client_status")
}

model Exercise {
  id        String  @id @default(uuid()) @db.Uuid
  trainerId String? @map("trainer_id") @db.Uuid
  trainer   User?   @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  name             String  @db.Text
  muscleGroup      String? @map("muscle_group") @db.Text
  primaryMuscles   Json?   @map("primary_muscles") @db.JsonB
  secondaryMuscles Json?   @map("secondary_muscles") @db.JsonB
  equipment        String? @db.Text
  description      String? @db.Text
  resultType       String? @map("result_type") @db.Text
  isSystem         Boolean @default(false) @map("is_system")
  systemKey        String? @unique @map("system_key") @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  templateItems WorkoutTemplateItem[]
  seriesItems   WorkoutSeriesItem[]
  sessionItems  WorkoutSessionItem[]

  @@index([trainerId])
  @@index([isSystem])
  @@map("exercises")
}

model WorkoutTemplate {
  id        String @id @default(uuid()) @db.Uuid
  trainerId String @map("trainer_id") @db.Uuid
  trainer   User   @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  clientId String? @map("client_id") @db.Uuid
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  title       String  @db.Text
  description String? @db.Text
  notes       String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  items    WorkoutTemplateItem[]
  sessions WorkoutSession[]

  @@index([trainerId])
  @@index([trainerId, clientId])
  @@index([trainerId, deletedAt])
  @@map("workout_templates")
}

model WorkoutTemplateItem {
  id                String          @id @default(uuid()) @db.Uuid
  workoutTemplateId String          @map("workout_template_id") @db.Uuid
  workoutTemplate   WorkoutTemplate @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)

  exerciseId String?   @map("exercise_id") @db.Uuid
  exercise   Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  order              Int
  titleSnapshot      String?  @map("title_snapshot") @db.Text
  resultType         String?  @map("result_type") @db.Text
  day                String?  @db.Text
  supersetWithNext   Boolean? @map("superset_with_next")
  plannedSetTargets  Json?    @map("planned_set_targets") @db.JsonB
  plannedSets        Int?     @map("planned_sets")
  plannedReps        Int?     @map("planned_reps")
  plannedWeight      Float?   @map("planned_weight")
  plannedDurationSec Int?     @map("planned_duration_sec")
  restSeconds        Int?     @map("rest_seconds")
  notes              String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workoutTemplateId])
  @@map("workout_template_items")
}

model WorkoutSession {
  id        String @id @default(uuid()) @db.Uuid
  trainerId String @map("trainer_id") @db.Uuid
  trainer   User   @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  clientId String? @map("client_id") @db.Uuid
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  workoutTemplateId String?          @map("workout_template_id") @db.Uuid
  workoutTemplate   WorkoutTemplate? @relation(fields: [workoutTemplateId], references: [id], onDelete: SetNull)

  seriesId String?        @map("series_id") @db.Uuid
  series   WorkoutSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  seriesSlotId String?            @map("series_slot_id") @db.Uuid
  seriesSlot   WorkoutSeriesSlot? @relation(fields: [seriesSlotId], references: [id], onDelete: SetNull)

  title              String               @db.Text
  status             WorkoutSessionStatus @default(PLANNED)
  occurrenceKey      String?              @map("occurrence_key") @db.Text
  scheduledAt        DateTime?            @map("scheduled_at")
  scheduledLocalDate DateTime?            @map("scheduled_local_date") @db.Date
  scheduledLocalTime String?              @map("scheduled_local_time") @db.Text
  timezone           String?              @db.Text
  labelSnapshot      String?              @map("label_snapshot") @db.Text
  durationMinutes    Int?                 @map("duration_minutes")
  focus              String?              @db.Text
  location           String?              @db.Text
  repeatDays         Json?                @map("repeat_days") @db.JsonB
  scheduleTimes      Json?                @map("schedule_times") @db.JsonB
  startedAt          DateTime?            @map("started_at")
  finishedAt         DateTime?            @map("finished_at")
  notes              String?              @db.Text
  version            Int                  @default(1)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  items WorkoutSessionItem[]

  @@unique([seriesId, occurrenceKey])
  @@index([trainerId])
  @@index([trainerId, clientId])
  @@index([trainerId, status])
  @@index([trainerId, scheduledAt])
  @@index([trainerId, updatedAt])
  @@index([seriesId, scheduledAt])
  @@map("workout_sessions")
}

enum WorkoutSessionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  SUPERSEDED

  @@map("workout_session_status")
}

model WorkoutSeries {
  id        String @id @default(uuid()) @db.Uuid
  trainerId String @map("trainer_id") @db.Uuid
  trainer   User   @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  clientId String @map("client_id") @db.Uuid
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  label             String?             @db.Text
  startDate         DateTime            @map("start_date") @db.Date
  timezone          String              @db.Text
  status            WorkoutSeriesStatus @default(ACTIVE)
  durationMinutes   Int?                @map("duration_minutes")
  focus             String?             @db.Text
  location          String?             @db.Text
  notes             String?             @db.Text
  scheduleVersion   Int                 @default(1) @map("schedule_version")
  version           Int                 @default(1)
  generationThrough DateTime?           @map("generation_through") @db.Date
  creationKey       String              @map("creation_key") @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  slots    WorkoutSeriesSlot[]
  items    WorkoutSeriesItem[]
  sessions WorkoutSession[]
  commands WorkoutSeriesCommand[]

  @@unique([trainerId, creationKey])
  @@index([trainerId, status])
  @@index([trainerId, clientId])
  @@index([trainerId, deletedAt])
  @@map("workout_series")
}

enum WorkoutSeriesStatus {
  ACTIVE
  PAUSED
  ENDED

  @@map("workout_series_status")
}

model WorkoutSeriesCommand {
  id             String        @id @default(uuid()) @db.Uuid
  trainerId      String        @map("trainer_id") @db.Uuid
  trainer        User          @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  seriesId       String        @map("series_id") @db.Uuid
  series         WorkoutSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  operation      String        @db.Text
  idempotencyKey String        @map("idempotency_key") @db.Text
  requestHash    String        @map("request_hash") @db.Text
  effectiveFrom  DateTime?     @map("effective_from") @db.Date
  resultThrough  DateTime      @map("result_through") @db.Date
  resultVersion  Int           @map("result_version")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@unique([trainerId, operation, idempotencyKey])
  @@index([seriesId, createdAt])
  @@map("workout_series_commands")
}

model WorkoutSeriesSlot {
  id        String        @id @default(uuid()) @db.Uuid
  seriesId  String        @map("series_id") @db.Uuid
  series    WorkoutSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  weekday   String        @db.Text
  localTime String        @map("local_time") @db.Text
  revision  Int
  order     Int
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  items    WorkoutSeriesItem[]
  sessions WorkoutSession[]

  @@unique([seriesId, revision, weekday, localTime])
  @@index([seriesId, revision, order])
  @@map("workout_series_slots")
}

model WorkoutSeriesItem {
  id           String            @id @default(uuid()) @db.Uuid
  seriesId     String            @map("series_id") @db.Uuid
  series       WorkoutSeries     @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesSlotId String            @map("series_slot_id") @db.Uuid
  seriesSlot   WorkoutSeriesSlot @relation(fields: [seriesSlotId], references: [id], onDelete: Cascade)

  exerciseId String?   @map("exercise_id") @db.Uuid
  exercise   Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  order              Int
  titleSnapshot      String   @map("title_snapshot") @db.Text
  resultType         String?  @map("result_type") @db.Text
  supersetWithNext   Boolean? @map("superset_with_next")
  plannedSetTargets  Json?    @map("planned_set_targets") @db.JsonB
  plannedSets        Int?     @map("planned_sets")
  plannedReps        Int?     @map("planned_reps")
  plannedWeight      Float?   @map("planned_weight")
  plannedDurationSec Int?     @map("planned_duration_sec")
  restSeconds        Int?     @map("rest_seconds")
  notes              String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([seriesId])
  @@index([seriesSlotId, order])
  @@map("workout_series_items")
}

model WorkoutSessionItem {
  id               String         @id @default(uuid()) @db.Uuid
  workoutSessionId String         @map("workout_session_id") @db.Uuid
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  exerciseId String?   @map("exercise_id") @db.Uuid
  exercise   Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  order              Int
  titleSnapshot      String   @map("title_snapshot") @db.Text
  resultType         String?  @map("result_type") @db.Text
  day                String?  @db.Text
  supersetWithNext   Boolean? @map("superset_with_next")
  plannedSetTargets  Json?    @map("planned_set_targets") @db.JsonB
  plannedSets        Int?     @map("planned_sets")
  plannedReps        Int?     @map("planned_reps")
  plannedWeight      Float?   @map("planned_weight")
  plannedDurationSec Int?     @map("planned_duration_sec")
  restSeconds        Int?     @map("rest_seconds")
  notes              String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  setResults WorkoutSetResult[]

  @@index([workoutSessionId])
  @@map("workout_session_items")
}

model WorkoutSetResult {
  id                   String             @id @default(uuid()) @db.Uuid
  workoutSessionItemId String             @map("workout_session_item_id") @db.Uuid
  workoutSessionItem   WorkoutSessionItem @relation(fields: [workoutSessionItemId], references: [id], onDelete: Cascade)

  setNumber      Int     @map("set_number")
  reps           Int?
  weight         Float?
  durationSec    Int?    @map("duration_sec")
  distanceMeters Float?  @map("distance_meters")
  completed      Boolean @default(false)
  notes          String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workoutSessionItemId])
  @@map("workout_set_results")
}

model AccountDeletionReceipt {
  operationId        String   @id @map("operation_id") @db.Uuid
  recoverySecretHash String   @map("recovery_secret_hash") @db.Text
  completedAt        DateTime @map("completed_at")
  expiresAt          DateTime @map("expires_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("account_deletion_receipts")
}

model ActivityEvent {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  type             String   @db.Text
  entityType       String?  @map("entity_type") @db.Text
  entityId         String?  @map("entity_id") @db.Uuid
  deduplicationKey String?  @unique @map("deduplication_key") @db.Text
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("activity_events")
}

model AuthIdentity {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  provider              String   @db.Text
  providerSubject       String   @map("provider_subject") @db.Text
  providerEmail         String?  @map("provider_email") @db.Text
  providerEmailVerified Boolean  @default(false) @map("provider_email_verified")
  rawProfile            Json?    @map("raw_profile")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

model RefreshToken {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  tokenHash          String    @map("token_hash") @db.Text
  deviceId           String?   @map("device_id") @db.Text
  userAgent          String?   @map("user_agent") @db.Text
  ipHash             String?   @map("ip_hash") @db.Text
  expiresAt          DateTime  @map("expires_at")
  revokedAt          DateTime? @map("revoked_at")
  rotatedFromTokenId String?   @map("rotated_from_token_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model EmailLoginCode {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @db.Text
  codeHash     String    @map("code_hash") @db.Text
  attemptCount Int       @default(0) @map("attempt_count")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  lastSentAt   DateTime? @map("last_sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("email_login_codes")
}

model OAuthState {
  id                    String    @id @default(uuid()) @db.Uuid
  provider              String    @db.Text
  stateHash             String    @unique @map("state_hash") @db.Text
  codeVerifierEncrypted String?   @map("code_verifier_encrypted") @db.Text
  redirectAfter         String?   @map("redirect_after") @db.Text
  expiresAt             DateTime  @map("expires_at")
  consumedAt            DateTime? @map("consumed_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  @@map("oauth_states")
}

model LoginTicket {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  provider   String    @db.Text
  ticketHash String    @unique @map("ticket_hash") @db.Text
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_tickets")
}
