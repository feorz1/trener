{
  "expo": {
    "name": "Trainer Foundation",
    "slug": "trainer-foundation",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "trainer",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.trainerfoundation",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Allow Trainer Foundation to connect to the local development server.",
        "NSBonjourServices": [
          "_expo._tcp",
          "_react-native-metro._tcp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111827"
      },
      "package": "com.anonymous.trainerfoundation"
    }
  }
}
