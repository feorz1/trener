#!/usr/bin/env bash
set -euo pipefail

output_file=""
format="plain"
for argument in "$@"; do
  case "$argument" in
    --file=*) output_file="${argument#--file=}" ;;
    --format=*) format="${argument#--format=}" ;;
  esac
done
[[ -n "$output_file" ]] || exit 64

case "${FAKE_PG_DUMP_MODE:-success}" in
  fail)
    printf '%s\n' '-- PostgreSQL database dump' >"$output_file"
    exit 42
    ;;
  empty)
    : >"$output_file"
    ;;
  success)
    if [[ "$format" == "custom" ]]; then
      printf 'PGDMP\001fixture\000' >"$output_file"
    else
      printf '%s\n' \
        '-- PostgreSQL database dump' \
        'CREATE TABLE fixture (id integer);' \
        '-- PostgreSQL database dump complete' >"$output_file"
    fi
    ;;
  *) exit 65 ;;
esac
