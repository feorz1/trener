#!/usr/bin/env bash
set -euo pipefail

case " $* " in
  *' --dbname='*) ;;
  *)
    printf 'fixture psql requires an explicit --dbname connection URI\n' >&2
    exit 2
    ;;
esac

# Consume the SQL so the production script exercises its normal stdin path.
while IFS= read -r _line; do :; done

if [[ "${FAKE_PREFLIGHT_EMPTY:-false}" == "true" ]]; then
  exit 0
elif [[ "${FAKE_PREFLIGHT_FAIL:-false}" == "true" ]]; then
  printf '%s\n' \
    $'active_email_duplicates\t0' \
    $'cross_owner_links\t1' \
    $'foreign_key_rules\t0' \
    $'migrations\t0' \
    $'orphans\t0' \
    $'release_schema_contract\t0' \
    $'system_exercise_seed\t0'
else
  printf '%s\n' \
    $'active_email_duplicates\t0' \
    $'cross_owner_links\t0' \
    $'foreign_key_rules\t0' \
    $'migrations\t0' \
    $'orphans\t0' \
    $'release_schema_contract\t0' \
    $'system_exercise_seed\t0'
fi
